{
    "name": "plaidly/plaidly-php",
    "description": "Official Plaidly PHP SDK",
    "type": "library",
    "keywords": ["plaidly", "crypto", "payments", "stablecoin", "ethereum", "solana"],
    "homepage": "https://github.com/plaidly/plaidly-php",
    "license": "MIT",
    "authors": [
        { "name": "Plaidly", "email": "dev@plaidly.io" }
    ],
    "support": {
        "docs": "https://docs.plaidly.io",
        "issues": "https://github.com/plaidly/plaidly-php/issues"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-hash": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": { "Plaidly\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Plaidly\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
